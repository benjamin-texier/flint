#!/usr/bin/env bash
#
# The gate, whole: `make lint` and `make test`, the same two commands CI runs
# and nothing else.
#
# Here rather than on every commit because it compiles: cold, clippy alone is
# fifteen seconds and a full rebuild is a minute, and a wait that long between
# writing a commit message and getting the prompt back is how people learn to
# type --no-verify. A push is already a pause.
#
# What this does not do is run the live checks — `make check-live` wants a
# Flint, a ClickHouse and a browser, and a hook that fails on a laptop with
# none of them is a hook that gets removed.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Nothing to check when the push deletes a ref.
read -r _local_ref local_sha _remote_ref _remote_sha || exit 0
[ "$local_sha" = "0000000000000000000000000000000000000000" ] && exit 0

echo "pre-push: make lint"
make lint >/dev/null || { echo "pre-push: lint failed — run \`make lint\`" >&2; exit 1; }

echo "pre-push: make test"
make test >/dev/null || { echo "pre-push: tests failed — run \`make test\`" >&2; exit 1; }

exit 0
