# Copy to .env and adjust. Read automatically by `docker compose up`, or for a
# bare `cargo run`: set -a; source .env; set +a

# Where Flint listens
FLINT_HOST=0.0.0.0
FLINT_PORT=9090

# The ClickHouse instance to explore
FLINT_CLICKHOUSE_URL=http://localhost:8123
FLINT_CLICKHOUSE_USER=default
FLINT_CLICKHOUSE_PASSWORD=
FLINT_CLICKHOUSE_DATABASE=default

# Refuse anything that is not a read. Recommended against production.
FLINT_READONLY=false

# What this deployment may do: read | data | ddl | admin. Unset follows
# FLINT_READONLY. The tiers above `data` are the ones that reshape a schema or
# operate a server, so they are opt-in.
# FLINT_TIER=data

# Whether the Infrastructure space exists in the UI at all. Off means absent —
# no navigation entry, no route — for a team that only ever queries.
FLINT_INFRASTRUCTURE=true

# Guard rails
FLINT_MAX_RESULT_ROWS=10000
FLINT_QUERY_TIMEOUT_SECS=120

# Private CA bundle, if ClickHouse is served over HTTPS with your own CA
# FLINT_CLICKHOUSE_CA_CERT=/etc/flint/ca.pem

# Allow the Vite dev server to call the API (development only)
# FLINT_CORS_ORIGIN=http://localhost:5173

# Logging
FLINT_LOG=flint=info,tower_http=warn

# ── docker compose only ─────────────────────────────────────────────────────
# The default URL reaches a ClickHouse running on the host machine; inside the
# container `localhost` would be the container itself.
# FLINT_CLICKHOUSE_URL=http://host.docker.internal:8123
