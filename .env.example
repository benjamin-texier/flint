# Copy to .env and adjust. Read automatically by `docker compose up`, or for a
# bare `cargo run`: set -a; source .env; set +a

# Where Flint listens
FLINT_HOST=0.0.0.0
FLINT_PORT=9090

# The ClickHouse instance to explore.
#
# Comment it out and Flint starts *unpinned*: it opens on a form asking where to
# connect, and the browser names the server at sign-in. Signing in is then
# required whatever FLINT_AUTH says, because the session is the only thing that
# can carry a target — and an unpinned Flint is stateless by construction, so
# FLINT_WORKSPACE_DATABASE is refused with it: nothing can run on a schedule
# when the schedule has no session to borrow a server from.
FLINT_CLICKHOUSE_URL=http://localhost:8123
FLINT_CLICKHOUSE_USER=default
FLINT_CLICKHOUSE_PASSWORD=
FLINT_CLICKHOUSE_DATABASE=default

# Servers a browser may point an *unpinned* Flint at: host, host:port or
# scheme://host:port, comma-separated. Empty — the default — means any, which is
# how `docker run flint` with no environment at all can work; it also means
# anyone who can reach this port can make Flint dial anything it can route to.
# Set it on an unpinned Flint that is not on your own laptop. Ignored while
# FLINT_CLICKHOUSE_URL is set, where nobody but this file has a say.
# FLINT_TARGETS=clickhouse:8123,warehouse.internal:8443

# Refuse anything that is not a read. Recommended against production.
FLINT_READONLY=false

# What this deployment may do: read | data | ddl | admin. Unset follows
# FLINT_READONLY. The tiers above `data` are the ones that reshape a schema or
# operate a server, so they are opt-in.
# FLINT_TIER=data

# Whether the Infrastructure space exists in the UI at all. Off means absent —
# no navigation entry, no route — for a team that only ever queries.
FLINT_INFRASTRUCTURE=true

# The disk Flint may write backups to. Unset means it takes none: ClickHouse
# refuses BACKUP TO Disk(...) unless the server's own backups.allowed_disk
# sanctions the destination, and Flint cannot read that setting.
# FLINT_BACKUP_DISK=backups

# Require everyone to sign in with their own ClickHouse credentials. Off means
# Flint connects as the account above and anyone who can reach the port is that
# account — fine on a laptop, wrong for a Flint several people share.
FLINT_AUTH=false
# FLINT_SESSION_IDLE_HOURS=12

# Roles a published endpoint may be made to run as. Empty — the default — means
# none, so nobody can hand one out by publishing.
#
# It only narrows anything if this Flint's own account gets its read access
# through roles: a grant made directly to the user stays in force whatever role
# is active. Flint checks that when an endpoint is saved and refuses rather than
# pretending, so a misconfigured deployment finds out at the form, not later.
# FLINT_DELEGATABLE_ROLES=reporting,partner_read

# Guard rails
FLINT_MAX_RESULT_ROWS=10000
FLINT_QUERY_TIMEOUT_SECS=120

# Private CA bundle, if ClickHouse is served over HTTPS with your own CA
# FLINT_CLICKHOUSE_CA_CERT=/etc/flint/ca.pem

# Allow the Vite dev server to call the API (development only)
# FLINT_CORS_ORIGIN=http://localhost:5173

# Logging
FLINT_LOG=flint=info,tower_http=warn

# ── docker compose only ─────────────────────────────────────────────────────
# The default URL reaches a ClickHouse running on the host machine; inside the
# container `localhost` would be the container itself.
# FLINT_CLICKHOUSE_URL=http://host.docker.internal:8123
