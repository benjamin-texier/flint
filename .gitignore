# Build output.
/target
/frontend/node_modules
/frontend/dist

# Vitest writes its cache to a `node_modules/.vite` beside the *root* rather
# than beside the frontend it is testing, so the rule above never sees it. Two
# directories of the same name, one of them twenty kilobytes of nothing.
/node_modules

# pnpm's content-addressed store, when the project keeps one locally. It is
# 130 MB of tarballs that `pnpm-lock.yaml` can rebuild byte for byte, and it
# sits inside `frontend/` rather than inside `node_modules/`, so none of the
# rules above catch it. This is how a repository doubles in size in one commit.
/frontend/.pnpm-store

# The real configuration, and only it. `.env.example` is the template the
# README tells you to copy, so it stays; anything else of that shape has
# somebody's ClickHouse password in it and does not. Stated as a pattern and a
# negation rather than as the one filename `.env`, because the file that leaks
# a credential is never the one you thought to name — it is `.env.local`, or
# `.env.prod` written at four in the afternoon.
.env
.env.*
!.env.example

# direnv's cache for .envrc, which is itself tracked.
.direnv/

# Coverage and incremental-build output. Neither exists until somebody asks for
# it — `vitest --coverage`, a `tsc` with `incremental` — which is exactly why
# they are named here rather than after the first one has been committed by
# accident.
/frontend/coverage
*.tsbuildinfo

# Editors and desktops leave their own files in a repository and each of them
# is one person's setting, not the project's. Listed rather than argued about:
# whoever brings a different editor should not have to open a pull request to
# ignore it.
.vscode/
.idea/
*.swp
.DS_Store
