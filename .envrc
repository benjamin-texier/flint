# direnv: the environment for working on Flint on this machine.
#
# Committed on purpose, so `cd` into the repo is enough to get a working
# `cargo run`. It holds no secrets — the password lives in .env, which is
# gitignored and loaded below.
#
#   cp .env.example .env      # put FLINT_CLICKHOUSE_PASSWORD in it
#   direnv allow
#
# These variables are for running on the host. Both compose files set their own
# environment and ignore everything here.

# Your own values first, so anything below is only a fallback.
dotenv_if_exists .env

# A ClickHouse on this machine, which is the usual case while developing.
export FLINT_CLICKHOUSE_URL="${FLINT_CLICKHOUSE_URL:-http://localhost:8123}"
export FLINT_CLICKHOUSE_USER="${FLINT_CLICKHOUSE_USER:-default}"

# The Vite dev server is a different origin, so the API has to allow it. Set
# here rather than remembered per terminal: forgetting it produces a CORS
# failure that looks like a bug in the app.
export FLINT_CORS_ORIGIN="${FLINT_CORS_ORIGIN:-http://localhost:5173}"

# FLINT_READONLY is deliberately NOT set here.
#
# Flint already allows writes by default, so exporting `false` would change
# nothing for a host run — but it would leak into `docker compose`, which
# interpolates the shell before .env and defaults that variable to `true`. The
# net effect of a redundant export would be to silently disable read-only mode
# for every container started from this directory. Put it in .env if you mean
# it; a safety default a stray shell variable can flip is not a default.

export FLINT_LOG="${FLINT_LOG:-flint=debug,tower_http=warn}"

# `flint` and `vite`/`tsc` on PATH without a prefix.
PATH_add target/debug
PATH_add target/release
PATH_add frontend/node_modules/.bin

# The one thing that will actually stop you.
if [ -z "${FLINT_CLICKHOUSE_PASSWORD:-}" ]; then
  log_status "FLINT_CLICKHOUSE_PASSWORD is unset — put it in .env if your ClickHouse needs one"
fi
